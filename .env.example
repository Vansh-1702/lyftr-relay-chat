# Replace these with two distinct keys from the provider in LLM_MODEL.
LLM_API_KEYS=replace-me-key-1,replace-me-key-2
LLM_MODEL=groq/openai/gpt-oss-20b
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Prefer clear, concise answers."
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=1024
LITELLM_LOCAL_MODEL_COST_MAP=True
PORT=8000
# This is public. Never put an API key in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
